<?xml version = '1.0' encoding = 'ISO-8859-1'?>
<!DOCTYPE taglib PUBLIC "-//Sun Microsystems, Inc.//DTD JSP Tag Library 1.2//EN" "http://java.sun.com/dtd/web-jsptaglibrary_1_2.dtd">
<taglib>

  <tlib-version>1.0</tlib-version>
  <jsp-version>1.2</jsp-version>
  <short-name>jwcache</short-name>
  <uri>http://xmlns.oracle.com/j2ee/jsp/tld/ojsp/jwcache.tld</uri>
  <description>Tag library for Web Object Cache for JSP</description>
  <!-- name="META-INF/taglib.tld" location="@oracle.home@/jsp/lib/tlds/jwcache.jar" -->

  <tag>
    <name>cache</name>
    <tag-class>oracle.jsp.jwcache.tagext.CacheTag</tag-class>
    <body-content>JSP</body-content>
    <description>Web Object Cache tag for char-based data.</description>
    <!-- page="OJSP Cache" -->
    <!-- icon="/oracle/jsp/palette/images/T_cache.gif" -->

    <attribute>
	<name>policy</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>ignoreCache</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>invalidateCache</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>scope</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>autoType</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>selectedParam</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>selectedCookies</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>reusableTimeStamp</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>reusableDeltaTime</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

    <attribute>
	<name>name</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

    <attribute>
	<name>expirationType</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>TTL</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>timeInaDay</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>dayInaWeek</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>dayInaMonth</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>writeThrough</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>


    <attribute>
	<name>printCacheBlockInfo</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>printCachePolicy</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>


    <attribute>
	<name>cacheRepositoryName</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

    <attribute>
        <name>reportException</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

  </tag>

  <tag>
    <name>invalidateCache</name>
    <tag-class>oracle.jsp.jwcache.tagext.InvalidateCacheTag</tag-class>
    <body-content>empty</body-content>
    <description>This tag invalidates web object cache.</description>
    <!-- page="OJSP Cache" -->
    <!-- icon="/oracle/jsp/palette/images/T_invalidateCache.gif" -->

    <attribute>
	<name>policy</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

    <attribute>
        <name>ignoreCache</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>scope</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>autoType</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>selectedParam</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
        <name>selectedCookies</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

    <attribute>
	<name>name</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>invalidateNameLike</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

    <attribute>
	<name>page</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>autoInvalidateLevel</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

    <attribute>
        <name>cacheRepositoryName</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

    <attribute>
        <name>reportException</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

  </tag>

  <tag>
    <name>cacheInclude</name>
    <tag-class>oracle.jsp.jwcache.tagext.CacheIncludeTag</tag-class>
    <body-content>empty</body-content>
    <description>web object cache tag for included page (char-based)</description>
    <!-- page="OJSP Cache" -->
    <!-- icon="/oracle/jsp/palette/images/T_cacheInclude.gif" -->

    <attribute>
	<name>policy</name>
	<required>true</required>
        <rtexprvalue>false</rtexprvalue>
    </attribute>
    <attribute>
	<name>page</name>
	<required>true</required>
        <rtexprvalue>false</rtexprvalue>
    </attribute>
    <attribute>
	<name>printCacheBlockInfo</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

    <attribute>
        <name>reportException</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

  </tag>



  <tag>
    <name>cacheXMLObj</name>
    <tag-class>oracle.jsp.jwcache.tagext.CacheXMLObjTag</tag-class>
    <tei-class>oracle.jsp.jwcache.tagext.CacheXMLObjTEI</tei-class>
    <body-content>JSP</body-content>
    <description>The Web Object Cache tag for XML DOM object.</description>
    <!-- page="OJSP Cache" -->
    <!-- icon="/oracle/jsp/palette/images/T_cacheXMLObj.gif" -->

    <attribute>
	<name>policy</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>ignoreCache</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>invalidateCache</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>scope</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>autoType</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>selectedParam</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>selectedCookies</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>reusableTimeStamp</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>reusableDeltaTime</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

    <attribute>
	<name>name</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

    <attribute>
	<name>expirationType</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>TTL</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>timeInaDay</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>dayInaWeek</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>dayInaMonth</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>writeThrough</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>


    <attribute>
	<name>printCacheBlockInfo</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>printCachePolicy</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>


    <attribute>
	<name>cacheRepositoryName</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

    <attribute>
	<name>fromXMLObjName</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>toXMLObjName</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>toWriter</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

    <attribute>
        <name>reportException</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

  </tag>

  <tag>
    <name>useCacheObj</name>
    <tag-class>oracle.jsp.jwcache.tagext.UseCacheObjTag</tag-class>
    <tei-class>oracle.jsp.jwcache.tagext.UseCacheObjTEI</tei-class>
    <body-content>JSP</body-content>
    <description>web object cache tag for generic Java serializable object</description>
    <!-- page="OJSP Cache" -->
    <!-- icon="/oracle/jsp/palette/images/T_useCacheObj.gif" -->

    <attribute>
	<name>policy</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>ignoreCache</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>invalidateCache</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>cacheScope</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>autoType</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>selectedParam</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>selectedCookies</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>reusableTimeStamp</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>reusableDeltaTime</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

    <attribute>
	<name>name</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

    <attribute>
	<name>expirationType</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>TTL</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>timeInaDay</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>dayInaWeek</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>dayInaMonth</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>writeThrough</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>


    <attribute>
	<name>printCacheBlockInfo</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>
    <attribute>
	<name>printCachePolicy</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>


    <attribute>
	<name>cacheRepositoryName</name>
	<required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>

    <attribute>
        <name>reportException</name>
        <required>false</required>
        <rtexprvalue>true</rtexprvalue>
    </attribute>


    <attribute>
        <name>id</name>
        <required>true</required>
        <rtexprvalue>false</rtexprvalue>
    </attribute>
    <attribute>
        <name>type</name>
        <required>true</required>
        <rtexprvalue>false</rtexprvalue>
    </attribute>


  </tag>

  
</taglib>

