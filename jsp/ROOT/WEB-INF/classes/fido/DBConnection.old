            "SELECT  P.CODE_PERSON ПАСПОРТ,P.LAST_NAME ФАМИЛИЯ,P.NAME ИМЯ,P.PATRONYMIC ОТЧЕСТВО,d.CURRENCY_SUM СУММА_ОБМЕНА, "+
