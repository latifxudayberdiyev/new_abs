  // получение sql-запроса на просмотр таблицы
  public String getSql(String sForm) {
    Form formV=(Form)formStorehouse.elementAt(Integer.parseInt(sForm));
    StringBuffer cSql=new StringBuffer("Select "+
    formV.getSqlField()+" FROM "+formV.getSqlFrom());
    boolean isWhere=false;
    // постоянное условие
    if (formV.getSqlCondC()!=null) {
      cSql.append(" Where ("+formV.getSqlCondC()+")");
      isWhere=true;
    }
    // условие пользователя
    if (formV.getSqlCondV()!=null) {
      if (isWhere) {
        cSql.append(" And ("+formV.getSqlCondV()+")");}
      else {
        cSql.append(" Where "+formV.getSqlCondV());
      }
    }
    // порядок следования
    if (formV.getSqlOrder()!=null) {
        cSql.append(" Order By "+formV.getSqlOrder());
    }
    // добавление страниц
    if (formV.getPage()!="0") {
      cSql.insert(0,"Select * from (SELECT abcdefg.*,ceil(rownum/"+
        formV.getCountPage()+") page From (");
      cSql.append(") abcdefg) Where Page="+formV.getPage());
    }
    return(cSql.toString());
  }

