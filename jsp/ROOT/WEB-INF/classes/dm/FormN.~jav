  public String execProc(iabs.oraDBConnection rDBConn, String sForm, String cSql){
    //FormN fm=(FormN)formStorehouse.elementAt(Integer.parseInt(sForm));
    //FormN fm=new FormN();
    //fm=(FormN)formStorehouse.elementAt(Integer.parseInt(sForm));
    String sOption=this.getOptions(sForm);
    String sErr="";
    Connection conn = rDBConn.getConnection();
    if (sOption.indexOf("P")!=-1) {
      CallableStatement cs = null;
      try
      {
        cs = conn.prepareCall("{ call DM_EXEC(?,?) }");
        cs.setString(1, cSql);
        cs.registerOutParameter(2,java.sql.Types.VARCHAR);
        cs.execute();
        sErr=cs.getString(2);
      } catch(Exception e) {
        sErr="Ошибка в запросе "+cSql+" "+e.toString();
        //sErr=sErr+"Ошибка при выполнении процедуры "+e.toString();
      }
      try
      {
        cs.close();
      } catch(Exception e) {
        sErr=sErr+"Ошибка при выполнении процедуры "+e.toString();
      }
    } else {
      try {
        Statement stmt = conn.createStatement ();
        stmt.executeUpdate(cSql);
        stmt.close();
      } catch(Exception e) {
        sErr="Ошибка в запросе "+cSql+" "+e.toString();
      }
    }
    if (sErr==null) {sErr="";}
    return(sErr);
  }
