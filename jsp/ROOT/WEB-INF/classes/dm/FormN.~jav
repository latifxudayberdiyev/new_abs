    fm.setHtmlDelete(htmlDelete);
    fm.setHtmlUpdate(htmlUpdate);
    fm.setSequensName(sequensName);
    fm.setHtmlExit(htmlExit);
    fm.setHtmlFloor(htmlFloor);
    fm.setAField(arraySize);
    this.form=String.valueOf(i);
    formStorehouse.addElement(fm);
    i=i+1;
    return(i-1);
  }
