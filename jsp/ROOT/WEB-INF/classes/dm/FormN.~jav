  // определение новой формы
  public int setTableName(String formName,String title,String tableName,
      String sqlField, String sqlFrom, String sqlCondC, String sqlCondV,
      String sqlOrder, String page, String countPage, String options,
      String htmlInsert, String htmlEdit, String htmlFilter, String htmlDelete,
      String htmlUpdate, String sequensName, String htmlExit, String htmlFloor,
      int arraySize) {
    j=0;
