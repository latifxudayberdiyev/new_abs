  public static String format_soumE(String s, int Scale)
  {
      if (s == null) s = new String("0");
      if (s.trim().equals("")) s = "0";
      s = s.trim();
      double dS= new Double(s).doubleValue();
      String st=format_soumE(dS, Scale).replace('.',',');
      return(st);
  }
  public static String format_soum(double d, int Scale)
  {
    String sPattern="#0."+Replicate('0',Scale);
    String sValue=String.valueOf(d);
    if (sValue.indexOf("E")!=-1) {
      return(formatCurrency(d,Scale));
    }
    DecimalFormatSymbols dfs = new DecimalFormatSymbols(Locale.US);
    dfs.setGroupingSeparator(' ');
    DecimalFormat df = new DecimalFormat();
    df.setDecimalFormatSymbols(dfs);
    df.applyPattern(sPattern);
    df.setMinimumFractionDigits(Scale);
    df.setMaximumFractionDigits(Scale);
    return df.format(d);
  }
  public static String format_soumE(double d, int Scale)
  {
    String sValue=String.valueOf(d);
    if (sValue.indexOf("E")!=-1) {
      return(formatCurrencyE(d,Scale));
    }
    DecimalFormatSymbols dfs = new DecimalFormatSymbols();
    DecimalFormat df = new DecimalFormat();
    df.setDecimalFormatSymbols(dfs);
    df.setMinimumFractionDigits(Scale);
    df.setMaximumFractionDigits(Scale);
    String st=df.format(d).replace('.',',');
    return(st);
  }
	public static String formatCurrency(double value, int radix) 	// value - сумма в неделимых единицах  - копейках
	                                          							// radix - кол-во разрядов после запятой
	{
		DecimalFormatSymbols dfs = new DecimalFormatSymbols(Locale.US);
		dfs.setGroupingSeparator(' ');
		DecimalFormat df = new DecimalFormat();
		df.setDecimalFormatSymbols(dfs);
    df.setMinimumFractionDigits(radix);
		df.setMaximumFractionDigits(radix);
		return df.format(value);
	}
	public static String formatCurrencyE(double value, int radix)
	{
    // value - сумма в неделимых единицах  - копейках
    // radix - кол-во разрядов после запятой
		DecimalFormatSymbols dfs = new DecimalFormatSymbols(Locale.US);
		DecimalFormat df = new DecimalFormat();
		df.setDecimalFormatSymbols(dfs);
    df.setMinimumFractionDigits(radix);
		df.setMaximumFractionDigits(radix);
		return(df.format(value).replace('.',','));
	}
