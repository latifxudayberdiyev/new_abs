  public static String Align(String str, String pref, int ln){
    String st= new String();
    str=str.trim();
    int len=str.length();
    if (len>ln) {
      st=str.substring(1,ln);
    } else if (pref.equals("left")) {
      st=str+Replicate(' ',ln-len);
    } else if (pref.equals("right")) {
      st=Replicate(' ',ln-len)+str;
    } else if (pref.equals("center")) {
      st=Replicate(' ',(ln-len)/2)+str+Replicate(' ',ln-len-(ln-len)/2);
    } else {st=str;}
    return(st);
  }
