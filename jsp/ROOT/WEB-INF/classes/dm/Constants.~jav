  public static String getInn(iabs.oraDBConnection rDBConn, String sFilial){
    String sErr="",sValue="";
    Connection conn = rDBConn.getConnection();
    CallableStatement cs = null;
    String sPC="000"+sFilial;
    try {
      cs = conn.prepareCall("{ ? = call trim(BANK.GET_CLIENT_INN('"+sPC+"')) }");
      cs.registerOutParameter(1,Types.VARCHAR);
      cs.execute();
      sValue = cs.getString(1);
      cs.close();
    } catch(Exception e) {
      sErr=sErr+"Ошибка при определении ИНН плательщика "+e.toString();
    }
    //this.err=sErr;
    return(sValue);
  }
