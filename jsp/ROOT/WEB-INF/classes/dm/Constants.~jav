  public String getSqlState(iabs.oraDBConnection rDBConn, String sField) {
    Connection conn = rDBConn.getConnection();
    String cSql="Select CODE,NAME From Dm_State";
    String st="";
    try {
      Statement stmt = conn.createStatement();
      ResultSet QR = stmt.executeQuery(cSql);
      st="nvl(decode("+sField;
      while (QR.next()) {
        st=st+","+QR.getString("CODE")+","+getS(QR.getString("NAME"));
      }
      st=st+"),"+sField+") STATE";
      if (QR!=null) {QR.close();}
      stmt.close();
    } catch(Exception e) {
      st="nvl(decode("+sField+",1,'Введен',2,'Зарегистрирован',3,'Отправлен',4,'Проведен',5,'Ошибка',6,'Утвержден',7,'Открыт',8,'Закрыт',9,'Аннулирован',10,'Активен',11,'Неактивен'),"+sField+") STATE";
    }
    return(st);
  }

