	public synchronized String dateToString(java.util.Date d) throws Exception {
		return sdf.format(d);
	}
	public synchronized java.util.Date stringToDate(String s) throws Exception {
		return sdf.parse(s);
	}
  public synchronized java.util.Date getBOM(String sDt) throws Exception {
    java.util.Date dt= new java.util.Date();
    dt=stringToDate(sDt);
    dt.setDate(1);
    return(dt);
  }
  public synchronized java.util.Date getEOM(String sDt) throws Exception {
    java.util.Date dt= new java.util.Date();
    dt=getBOM(sDt);
    dt.setMonth(dt.getMonth()+1);
    dt.setDate(dt.getDate()-1);
    return(dt);
  }

  public synchronized String stringBOM(String sDt) throws Exception {
    java.util.Date dt= new java.util.Date();
    dt=stringToDate(sDt);
    dt.setDate(1);
    return(dateToString(dt));
  }
  public synchronized String stringEOM(String sDt) throws Exception {
    java.util.Date dt= new java.util.Date();
    dt=getBOM(sDt);
    dt.setMonth(dt.getMonth()+1);
    dt.setDate(dt.getDate()-1);
    return(dateToString(dt));
  }

  public synchronized java.util.Date dateAddMonth(String sDt, int Month) throws Exception {
    java.util.Date dt= new java.util.Date();
    dt=stringToDate(sDt);
    dt.setMonth(dt.getMonth()+Month);
    return(dt);
  }
  public synchronized String stringAddMonth(String sDt, int Month) throws Exception {
    java.util.Date dt= new java.util.Date();
    dt=stringToDate(sDt);
    dt.setMonth(dt.getMonth()+Month);
    return(dateToString(dt));
  }

  public synchronized String stringYear(String sDt) throws Exception {
    java.util.Date dt= new java.util.Date();
    dt=stringToDate(sDt);
    int year=1900+dt.getYear();
    return(String.valueOf(year));
  }

