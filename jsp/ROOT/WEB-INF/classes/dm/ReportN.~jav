  public String getFieldChkSayText(iabs.oraDBConnection rDBConn, String sForm, int nF, String sValue) {
    String sEH="",cSql;
    int i;
    String fieldName;
    Report formV=(Report)reportForm.elementAt(Integer.parseInt(sForm));
    FieldR field=new FieldR();
    field=formV.aField[nF];
    cSql=field.getFieldChkSay();
    if (cSql==null) {cSql="";}
    if (cSql.equals("")) {
      return(sValue);
    } else {
      if (cSql.indexOf("Where")!=-1) {
        cSql=cSql+" and "+field.getFieldAlias()+"=";
      } else {
        cSql=cSql+" Where "+field.getFieldAlias()+"=";
      }
      if (field.getFieldType().equals("string")) {
       cSql=cSql+Constants.getS(sValue);
      } else {
       cSql=cSql+sValue;
      }
      Connection conn = rDBConn.getConnection();
      try {
        Statement stmt9 = conn.createStatement();
        ResultSet QR1 = stmt9.executeQuery(cSql);
        while(QR1.next()) {
          sEH=QR1.getString(1);
        }
        QR1.close();
        stmt9.close();
      } catch(Exception e) {
        this.err="Ошибка в запросе "+cSql+" "+e.toString();
        sEH=this.err;
      }
    }
    return(sEH);
