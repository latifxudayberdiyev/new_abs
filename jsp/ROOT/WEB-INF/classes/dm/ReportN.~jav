  // получение sql-запроса на просмотр таблицы
  public String getSql(String sForm) {
    Report formV=(Report)reportForm.elementAt(Integer.parseInt(sForm));
    StringBuffer cSql=new StringBuffer("Select "+
    formV.sqlField+" FROM "+formV.sqlFrom);
    boolean isWhere=false;
    // постоянное условие
    if (formV.sqlCondC!=null) {
      cSql.append(" Where ("+formV.sqlCondC+")");
      isWhere=true;
    }
    // условие пользователя
    if (formV.sqlCondV!=null) {
      if (isWhere) {
        cSql.append(" And ("+formV.sqlCondV+")");}
      else {
        cSql.append(" Where "+formV.sqlCondV);
      }
    }
    // порядок следования
    if (formV.sqlOrder!=null) {
      if (formV.option.indexOf("G")!=-1) {
        cSql.append(" Group By "+formV.sqlOrder);
      } else {
        cSql.append(" Order By "+formV.sqlOrder);
      }
    }
    return(cSql.toString());
  }
