  // отображение полей для Edit.jsp по шаблону
  public String getStringEdit(iabs.oraDBConnection rDBConn, String sForm) {
    Connection conn = rDBConn.getConnection();
    String isNew="new";
    int i;
    String fieldName;
    String sES="",cSql,sErr="",sValue="",st="",sp1="",sp2="", sKey="";
    //Report myFormN=new Report();
    String sPattern="";
    int Col_Count = this.getCountFields(sForm);
    for (i=0; i<Col_Count;i++) {
      sPattern=sPattern+this.getFieldName(sForm,i)+";";
    }
    while(sPattern.length()>0) {
      fieldName=sPattern.substring(0,sPattern.indexOf(";"));
      sPattern=sPattern.substring(sPattern.indexOf(";")+1);
      i=this.getFieldNumber(sForm,fieldName);
      if ( (this.getFieldTypeFilter(sForm,i).equals("")==false)&&
         (this.getFieldTypeFilter(sForm,i).equals("none")==false) )
      {
        // заголовок
        sES=sES+"<TR>"+"\n";
        sES=sES+"<TD>"+"\n";
        if (this.getFieldTypeEdit(sForm,i).equals("sequens")==false) {
          sES=sES+this.getFieldDisplay(sForm,i)+"\n";
        }
        sES=sES+"</TD>"+"\n";
        sES=sES+"<TD>"+"\n";

        // SELECT
        if (this.getFieldTypeEdit(sForm,i).equals("select")) {
          cSql=this.getFieldSqlLokup(sForm,i);
          sES=sES+"<SELECT class='spisok' name="+this.getFieldName(sForm,i)+">"+"\n";
          try {
            Statement stmt9 = conn.createStatement();
            ResultSet QR1 = null;
            QR1 = stmt9.executeQuery(cSql);
            while(QR1.next()) {
              sES=sES+"<Option value="+QR1.getString(1)+">"+QR1.getString(2)+"\n";
            }
            QR1.close();
            stmt9.close();
          } catch(Exception e) {
            sErr=sErr+"Ошибка в запросе "+cSql+" "+e.toString();
          }
          sES=sES+"</SELECT>"+"\n";
          //if (isNew.equals("edit")) {
            sValue=this.getFieldValue(sForm,i).trim();
            if (sValue==null) {sValue="";}
            sValue=sValue.trim();
            if ( (sValue.equals(""))&&(this.getFieldType(sForm,i).equals("string")==false) ){
              sValue="0";
            }
            if (this.getFieldType(sForm,i).equals("string")) {
              sValue=getS(sValue);
            }
            sES=sES+"<script>"+"\n";
            sES=sES+"EditForm."+this.getFieldName(sForm,i)+".value ="+sValue+";"+"\n";
            sES=sES+"</script>"+"\n";
          //}
          sES=sES+"<script>"+"\n";
          sES=sES+this.getTestScript(sForm,i)+"\n";
          sES=sES+"</script>"+"\n";

        // INPUT
        } else if (this.getFieldTypeEdit(sForm,i).equals("input")) {
          st="<INPUT class='pole' type='text' name="+this.getFieldName(sForm,i)+
            " size="+this.getFieldWidth(sForm,i)+
            " maxlength="+this.getFieldSize(sForm,i);
            sValue=this.getFieldValue(sForm,i);
            if (sValue==null) {sValue="";
            } else {sValue=sValue.trim();}
            st=st+" value="+getS(sValue);
          st=st+">";
          sES=sES+st+"\n";
          sES=sES+"<script>"+"\n";
          sES=sES+this.getTestScript(sForm,i)+"\n";
          sES=sES+"</script>"+"\n";

        // SPISOK
        } else if (this.getFieldTypeEdit(sForm,i).equals("spisok")) {
          cSql=this.getFieldSqlLokup(sForm,i);
          sES=sES+"<SELECT class='spisok' name="+this.getFieldName(sForm,i)+">"+"\n";
          while(cSql.length()>0) {
            sp1=cSql.substring(0,cSql.indexOf(" "));
            sp1=sp1.trim();
            sp2=cSql.substring(cSql.indexOf(" "),cSql.indexOf(";"));
            sp2=sp2.trim();
            cSql=cSql.substring(cSql.indexOf(";")+1);
            sES=sES+"<Option value="+sp1+">"+sp2+"\n";
          }
          sES=sES+"</SELECT>"+"\n";
          if (isNew.equals("edit")) {
            sValue=this.getFieldValue(sForm,i).trim();
            sES=sES+"<script>"+"\n";
            if (this.getFieldType(sForm,i).equals("string")) {
              sValue=getS(sValue);
            }
            sES=sES+"EditForm."+this.getFieldName(sForm,i)+".value ="+sValue+";"+"\n";
            sES=sES+"</script>"+"\n";
          }
          sES=sES+"<script>"+"\n";
          sES=sES+this.getTestScript(sForm,i)+"\n";
          sES=sES+"</script>"+"\n";

        }
        sES=sES+"</TD>"+"\n";
        sES=sES+"</TR>"+"\n";
      }
    }
    return(sES);
  }
