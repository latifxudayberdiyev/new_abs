
<wcache-config>

<cache-repository>
<cache-repository-name>DefaultCacheRepository</cache-repository-name>
<cache-repository-class>oracle.jsp.jwcache.repository.impl.OCSRepoImpl</cache-repository-class>
</cache-repository>

<cache-repository>
<cache-repository-name>SimpleFSRepo</cache-repository-name>
<cache-repository-class>oracle.jsp.jwcache.repository.impl.SimpleFSRepositoryImpl</cache-repository-class>
<init-param>
<param-name>reporoot</param-name>
<param-value>/tmp/reporoot</param-value>
</init-param>
</cache-repository>

</wcache-config>

